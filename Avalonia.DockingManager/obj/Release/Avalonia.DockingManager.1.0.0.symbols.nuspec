    <readme>README.md</readme>
    <projectUrl>https://github.com/platontrey/Avalonia-Docking-Manager</projectUrl>
    <description>A highly customizable, MVVM-friendly Docking Manager for Avalonia UI, heavily inspired by the window management systems of Unreal Engine 5 and JetBrains IDEs. Supports drag and drop, tear-off windows, nested layout workspaces, and smooth real-time resizing.</description>
    <tags>avalonia avaloniaui docking dock manager layout mvvm ui windows</tags>
    <repository type="git" url="https://github.com/platontrey/Avalonia-Docking-Manager" commit="7f8c9bc03b20db3878f7a41b4060817a14f481ae" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Avalonia" version="12.0.3" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Desktop" version="12.0.3" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Themes.Fluent" version="12.0.3" exclude="Build,Analyzers" />
        <dependency id="CommunityToolkit.Mvvm" version="8.4.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
