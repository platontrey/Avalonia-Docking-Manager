<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Avalonia.DockingManager.Controls"
             xmlns:models="clr-namespace:Avalonia.DockingManager.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Avalonia.DockingManager.Controls.DockManager">
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type models:DockGroupNode}">
            <controls:DockGroup DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:DockTabGroupNode}">
            <controls:DockTabGroup DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:DockPanelNode}">
            <ContentControl Content="{Binding Content}" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <!-- The main layout root -->
        <ContentControl x:Name="LayoutHost"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- Overlay layer for Drag & Drop visual guides will go here -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
    </Grid>
</UserControl>
